# Copy to .env.local (host dev) or .env.testnet (docker compose).
HEDERA_NETWORK=testnet
ACCOUNT_A_ID=0.0.xxxxx        # broker: submits to HCS, receives payment
ACCOUNT_A_KEY=302e...
ACCOUNT_B_ID=0.0.yyyyy        # buyer (for the demo)
ACCOUNT_B_KEY=302e...

# postgres — localhost for host dev, `postgres` service host inside compose
DATABASE_URL=postgres://nowcast:nowcast@localhost:5432/nowcast

FEE_BPS=0                     # 0 = self-broker mode
PUBLISH_SECRET=dev-secret

# The HCS topic and Mirror Node endpoints are hardcoded in shared/constants.ts.
